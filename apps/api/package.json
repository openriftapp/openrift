{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "test:integration": "bun --env-file=../../.env run src/test/run-integration.ts",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "tsgo",
    "build:tsc": "NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.14",
    "@better-auth/core": "1.7.14",
    "@hono/swagger-ui": "0.6.2",
    "@openrift/shared": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orpc/contract": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@piltoverarchive/riftbound-deck-codes": "1.5.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/bun": "11.9.0",
    "better-auth": "1.7.14",
    "croner": "11.0.0",
    "hono": "4.13.14",
    "hono-rate-limiter": "0.5.4",
    "kysely": "0.29.7",
    "kysely-postgres-js": "5.0.1",
    "nodemailer": "10.2.1",
    "onnxruntime-node": "1.31.1",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "swagger-ui-dist": "5.34.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@types/bun": "1.4.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
