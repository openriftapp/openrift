// Type-checks the whole package, tests included. `tsconfig.json` excludes
// `*.test.ts` because `build` checks production sources only, so without this
// config 293 test files were never checked at all. This is the config
// `bun run typecheck` uses, a superset of the build config's file set.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo.test"
  },
  "include": ["src"],
  "exclude": []
}
