{
  "name": "discord-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "dev:prod": "API_INTERNAL_URL=https://openrift.app SITE_URL=https://openrift.app bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@openrift/shared": "workspace:*",
    "@orpc/client": "1.16.5",
    "@orpc/contract": "1.16.5",
    "@orpc/openapi-client": "1.16.5",
    "discord.js": "14.28.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
