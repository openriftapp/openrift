{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "vite dev --clearScreen false",
    "build": "vite build && tsgo -b",
    "analyze": "ANALYZE=1 vite build",
    "start": "bun --env-file=../../.env .output/server/index.mjs",
    "start:lh": "COMPRESS=1 bun run build && bun run start",
    "routes:generate": "tsr generate",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --output-structure locale-modules",
    "typecheck": "bun run paraglide:compile && tsgo -b",
    "lint": "eslint . --max-warnings=0"
  },
