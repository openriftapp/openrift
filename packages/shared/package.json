{
  "name": "@openrift/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./otel": "./src/otel/span.ts",
    "./otel-node": "./src/otel/tracing-node.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "build": "tsgo",
    "typecheck": "tsgo",
    "dev": "tsgo --watch",
    "db:migrate": "bun --env-file=../../.env ../../scripts/run-migrations.ts",
    "db:rollback": "bun --env-file=../../.env ../../scripts/run-migrations.ts down",
    "make-admin": "bun --env-file=../../.env ../../scripts/make-admin.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orpc/contract": "1.16.1",
    "@piltoverarchive/riftbound-deck-codes": "1.5.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-hast": "13.2.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/qrcode": "1.5.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
